# Copie este arquivo para .env.local e preencha os valores reais.
# NUNCA commitar .env.local (já está no .gitignore).
# NUNCA colar valores reais deste arquivo na conversa com o Claude Code.

# --- ClickUp ---
# Token pessoal de API (Configurações > Apps no ClickUp). Só usado em rotas de servidor.
CLICKUP_API_TOKEN=

# IDs já resolvidos via API do ClickUp (workspace "Formô | Criação"):
CLICKUP_SPACE_ID=90131655727
CLICKUP_LIST_ID=901305578502

# IDs dos custom fields da lista "Solicitações Criação Formô" usados pelo formulário enxuto:
CLICKUP_FIELD_TIPO_SOLICITACAO=4e71fc4c-45ea-455f-95b7-5caf940da98a
CLICKUP_FIELD_NOME_TURMA=61646211-75b8-4365-9567-d71ac51a47ba

# Status inicial (slug) em que a task deve ser criada:
CLICKUP_STATUS_INICIAL=briefings
# Status que dispara o e-mail de entrega (etapa 4 do plano de build):
CLICKUP_STATUS_FINALIZADO=finalizado

# Segredo do webhook do ClickUp — só existe depois de registrar o webhook de
# verdade (na etapa de deploy, quando temos uma URL pública). Até lá, deixe
# em branco: a rota funciona sem verificar assinatura, só pra testar localmente.
CLICKUP_WEBHOOK_SECRET=

# --- E-mail transacional (etapa 4) ---
# Chave de API do Resend (https://resend.com). Só usada em rota de servidor.
RESEND_API_KEY=
# Remetente. Enquanto o domínio da Formô não estiver verificado no Resend,
# use o domínio de teste deles: "Formô Brasil <onboarding@resend.dev>".
RESEND_FROM_EMAIL=Formô Brasil <onboarding@resend.dev>

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
